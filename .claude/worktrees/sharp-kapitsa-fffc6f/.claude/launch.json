{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Python static server",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "src"],
      "port": 8080
    },
    {
      "name": "Node static server (npx serve)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "src", "-p", "8081", "--no-clipboard"],
      "port": 8081
    }
  ]
}
